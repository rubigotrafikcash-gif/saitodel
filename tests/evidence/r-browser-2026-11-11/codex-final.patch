diff --git a/script.js b/script.js
index ec71369..dee004e 100644
--- a/script.js
+++ b/script.js
@@ -15,8 +15,11 @@ function closeMenu(returnFocus = false) {
 siteHeader.classList.add("js-nav");
 menuToggle.hidden = !mobileQuery.matches;
 mobileQuery.addEventListener("change", (event) => {
+  const navHadFocus = mainNav.contains(document.activeElement);
+  const toggleHadFocus = document.activeElement === menuToggle;
   menuToggle.hidden = !event.matches;
-  closeMenu();
+  closeMenu(event.matches && navHadFocus);
+  if (!event.matches && toggleHadFocus) mainNav.querySelector("a").focus();
 });
 menuToggle.addEventListener("click", () => {
   const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
@@ -39,7 +42,9 @@ document.addEventListener("keydown", (event) => {
   if (event.key === "Escape" && menuToggle.getAttribute("aria-expanded") === "true") closeMenu(true);
 });
 function closeMenuOutsideHeader(event) {
-  if (!siteHeader.contains(event.target) && menuToggle.getAttribute("aria-expanded") === "true") closeMenu();
+  if (!siteHeader.contains(event.target) && menuToggle.getAttribute("aria-expanded") === "true") {
+    closeMenu(mobileQuery.matches && mainNav.contains(document.activeElement));
+  }
 }
 document.addEventListener("click", closeMenuOutsideHeader);
 document.addEventListener("focusin", closeMenuOutsideHeader);
